rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Health / connection test document (read-only for boot diagnostics)
    match /test/connection {
      allow get: if true;
    }

    // Security & validation primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Primary Master Admin: cryptographically verified identity anchored directly to Google Auth token
    function isPrimaryMasterAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email == 'placework908@gmail.com';
    }

    // User Profile helpers
    function hasUserDoc(uid) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(uid));
    }

    function getUserDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // Approved recruiter check:
    // Requires verified Master Admin OR an approved user profile with role RECRUITER or MASTER_ADMIN.
    // Unapproved, pending, suspended, or rejected users are strictly blocked from recruitment data.
    function isApprovedRecruiter() {
      return isSignedIn() && (
        isPrimaryMasterAdmin() ||
        (
          hasUserDoc(request.auth.uid) &&
          getUserDoc(request.auth.uid).status == 'APPROVED' &&
          getUserDoc(request.auth.uid).role in ['RECRUITER', 'MASTER_ADMIN']
        )
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Trusted Company Membership Directory
    // Clients can never write or tamper with this collection; must be managed via Admin SDK/backend
    match /company_members/{memberId} {
      allow get: if isSignedIn() && (request.auth.uid == memberId || isPrimaryMasterAdmin());
      allow list: if false;
      allow write: if false;
    }

    // User Profile Collection:
    // - Only primary Master Admin may list user profiles or update another user's role/approval status.
    // - Ordinary users may only create their initial profile as PENDING with role PUBLIC_USER.
    // - Ordinary users may update only safe fields (displayName, photoURL, lastActiveAt) on their own profile.
    match /users/{userId} {
      allow get: if isOwner(userId) || isPrimaryMasterAdmin();
      allow list: if isPrimaryMasterAdmin();

      // CREATE:
      // Primary Master Admin is permitted to bootstrap as APPROVED / MASTER_ADMIN.
      // Any other user can only create their profile with status PENDING and role PUBLIC_USER.
      allow create: if isOwner(userId)
        && isValidId(userId)
        && incoming().userId == request.auth.uid
        && incoming().email is string
        && incoming().email.size() <= 256
        && (
          isPrimaryMasterAdmin() ||
          (
            incoming().status == 'PENDING' &&
            incoming().role == 'PUBLIC_USER'
          )
        );

      // UPDATE:
      // 1. Primary Master Admin can update any user's role, status, or review fields.
      // 2. Ordinary user can ONLY update safe fields (displayName, photoURL, lastActiveAt) on their own profile.
      // 3. Primary Master Admin profile is permanently protected from modification by ordinary users.
      allow update: if isValidId(userId) && (
        isPrimaryMasterAdmin() ||
        (
          isOwner(userId) &&
          existing().email != 'placework908@gmail.com' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastActiveAt']) &&
          incoming().userId == existing().userId &&
          incoming().email == existing().email
        )
      );

      // User profile deletion is disallowed for all clients
      allow delete: if false;

      // Personal Resume Analysis Subcollection: strictly isolated to the owning user
      // Even company recruiters and admins CANNOT access public users' personal analyses
      match /analyses/{analysisId} {
        allow get: if isOwner(userId) && isValidId(analysisId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(analysisId)
          && incoming().userId == request.auth.uid
          && incoming().id is string
          && incoming().id.size() <= 128
          && incoming().fileName is string
          && incoming().fileName.size() <= 256
          && incoming().jobTitle is string
          && incoming().jobTitle.size() <= 200;
        allow update: if isOwner(userId)
          && isValidId(analysisId)
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId)
          && isValidId(analysisId);
      }
    }

    // Internal Job Requisitions Collection: RESTRICTED TO APPROVED RECRUITERS
    match /jobs/{jobId} {
      allow get: if isApprovedRecruiter() && isValidId(jobId);
      // SECURE LIST QUERY: Recruiters can ONLY list their own jobs.
      // List queries MUST include: where('userId', '==', request.auth.uid)
      allow list: if isApprovedRecruiter() && (
        isPrimaryMasterAdmin() || resource.data.userId == request.auth.uid
      );
      allow create: if isApprovedRecruiter()
        && isValidId(jobId)
        && incoming().userId == request.auth.uid
        && incoming().id is string
        && incoming().id.size() <= 128
        && incoming().title is string
        && incoming().title.size() <= 200
        && incoming().department is string
        && incoming().department.size() <= 100;
      allow update: if isApprovedRecruiter()
        && isValidId(jobId)
        && (isPrimaryMasterAdmin() || incoming().userId == existing().userId);
      allow delete: if isApprovedRecruiter()
        && isValidId(jobId)
        && (isPrimaryMasterAdmin() || resource.data.userId == request.auth.uid);
    }

    // Internal Candidates Collection: RESTRICTED TO APPROVED RECRUITERS
    match /candidates/{candidateId} {
      allow get: if isApprovedRecruiter() && isValidId(candidateId);
      // SECURE LIST QUERY: Recruiters can ONLY list their own candidates.
      // List queries MUST include: where('userId', '==', request.auth.uid)
      allow list: if isApprovedRecruiter() && (
        isPrimaryMasterAdmin() || resource.data.userId == request.auth.uid
      );
      allow create: if isApprovedRecruiter()
        && isValidId(candidateId)
        && incoming().userId == request.auth.uid
        && incoming().id is string
        && incoming().id.size() <= 128
        && incoming().jobId is string
        && incoming().jobId.size() <= 128;
      allow update: if isApprovedRecruiter()
        && isValidId(candidateId)
        && (isPrimaryMasterAdmin() || incoming().userId == existing().userId);
      allow delete: if isApprovedRecruiter()
        && isValidId(candidateId)
        && (isPrimaryMasterAdmin() || resource.data.userId == request.auth.uid);
    }

    // Internal Candidate Screening Analyses Collection: RESTRICTED TO APPROVED RECRUITERS
    match /analyses/{analysisId} {
      allow get: if isApprovedRecruiter() && isValidId(analysisId);
      // SECURE LIST QUERY: Recruiters can ONLY list their own screening evaluations.
      // List queries MUST include: where('userId', '==', request.auth.uid)
      allow list: if isApprovedRecruiter() && (
        isPrimaryMasterAdmin() || resource.data.userId == request.auth.uid
      );
      allow create: if isApprovedRecruiter()
        && isValidId(analysisId)
        && incoming().userId == request.auth.uid
        && incoming().id is string
        && incoming().id.size() <= 128
        && incoming().fileName is string
        && incoming().fileName.size() <= 256
        && incoming().jobTitle is string
        && incoming().jobTitle.size() <= 200;
      allow update: if isApprovedRecruiter()
        && isValidId(analysisId)
        && (isPrimaryMasterAdmin() || incoming().userId == existing().userId);
      allow delete: if isApprovedRecruiter()
        && isValidId(analysisId)
        && (isPrimaryMasterAdmin() || resource.data.userId == request.auth.uid);
    }
  }
}
