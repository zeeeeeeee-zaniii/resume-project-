# ==============================================================================
# Mihora Resume Intelligence - Production Environment Configuration Template
# ==============================================================================
# DO NOT commit real secrets, private keys, or credentials to source control.
# Copy or set these environment variables in your hosting provider (Render / Cloud Run).

# ------------------------------------------------------------------------------
# REQUIRED FOR PRODUCTION
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Google Gemini API key used on the server for resume evaluation.
# Obtain from Google AI Studio / Google Cloud Console. Kept strictly on the server.
GEMINI_API_KEY="your-gemini-api-key-here"

# ------------------------------------------------------------------------------
# OPTIONAL / HOSTING-PROVIDED
# ------------------------------------------------------------------------------
# NODE_ENV: Set to "production" in production environments (Render / Cloud Run).
NODE_ENV="production"

# PORT: The port the HTTP server binds to.
# Provided automatically by Render (default 10000) or Cloud Run (default 8080/3000).
PORT=3000

# APP_URL: The public canonical URL of your deployed application (e.g., https://mihora-resume.onrender.com).
# Used for CORS headers and self-referencing links.
APP_URL="https://your-app-name.onrender.com"

# AUTHORIZED_EMAILS: Optional comma-separated list of approved external recruiter or evaluator emails
# who are granted access without a @mihora.tech or @mihora.com Google Workspace domain.
# Verified accounts ending in @mihora.tech and @mihora.com are automatically authorized.
AUTHORIZED_EMAILS="recruiter.external@example.com,tester@example.com"
