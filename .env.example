# ==============================================================================
# Mihora Resume Intelligence - Production Environment Configuration Template
# ==============================================================================
# DO NOT commit real secrets, private keys, or credentials to source control.
# Copy or set these environment variables in your hosting provider (Vercel, Render, Cloud Run).

# ------------------------------------------------------------------------------
# REQUIRED FOR PRODUCTION (Server-Side Secret)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Google Gemini API key used on the server for resume evaluation.
# Used by: src/server/analysis-handler.ts (via @google/genai)
# Scope: SERVER-ONLY. Never prefix with VITE_ or expose to client bundle.
# Configure in: Vercel Project Settings -> Environment Variables (Production & Preview)
GEMINI_API_KEY="your-gemini-api-key-here"

# ------------------------------------------------------------------------------
# OPTIONAL CONFIGURATION / HOSTING PROVIDED
# ------------------------------------------------------------------------------
# NODE_ENV: Set to "production" in production environments.
# Scope: SERVER-ONLY (Vercel automatically sets this to "production").
NODE_ENV="production"

# AUTHORIZED_EMAILS: Optional comma-separated list of approved external recruiter or evaluator emails
# who are granted access without a @mihora.tech or @mihora.com Google Workspace domain.
# Scope: SERVER-ONLY. Verified accounts ending in @mihora.tech and @mihora.com are automatically authorized.
AUTHORIZED_EMAILS="recruiter.external@example.com,tester@example.com"

# FIREBASE_PROJECT_ID / FIREBASE_API_KEY: (Optional overrides)
# The application automatically reads the embedded firebase-applet-config.json.
# If hosting in an environment without this file, configure these server-side variables.
FIREBASE_PROJECT_ID="gen-lang-client-0699486567"
FIREBASE_API_KEY=""

# PORT: The port the HTTP server binds to when running server.ts directly.
# Used only when running containerized deployments (Docker, Cloud Run, Render). Not used by Vercel serverless.
PORT=3000

# APP_URL: Canonical public URL of your deployed application (e.g., https://your-project.vercel.app).
APP_URL="https://your-project.vercel.app"
